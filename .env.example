# ========================================================
# TARIQ & CO. TECH - EMAIL SENDER CONFIGURATION
# ========================================================
# To send live emails from your company Gmail (tariqcotech@gmail.com):
# 1. Go to your Google Account -> Security
# 2. Enable 2-Step Verification
# 3. Search for "App Passwords"
# 4. Create an App Password named "Client Hunter"
# 5. Paste the 16-character code below and rename this file to .env

SENDER_EMAIL=tariqcotech@gmail.com
SENDER_PASSWORD=your_16_character_app_password_here
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
